# Python virtual environments.
.venv
venv

# IDE settings.
.idea

# Python bytecode and tooling caches.
__pycache__/
.pytest_cache/
.ruff_cache/

# Local environment configuration.
.env
.env.*
!.env.example

# Runtime SQLite databases and sidecar files; keep the bundled sample.
*.sqlite
*.sqlite3
*.db
*.sqlite-*
*.sqlite3-*
*.db-*
!/backend/data/sample.sqlite

# Node.js dependencies.
/frontend/node_modules/
/backend/node_modules/

# Yarn Plug'n'Play files.
/frontend/.pnp
/frontend/.pnp.js

# Test coverage reports.
/frontend/coverage/
/backend/coverage/

# Generated build output.
/frontend/build/
/backend/build/

# macOS metadata.
/frontend/.DS_Store

# Frontend environment overrides.
/frontend/.env.local
/frontend/.env.development.local
/frontend/.env.test.local
/frontend/.env.production.local

# Package manager logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
